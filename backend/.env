PROJECT_NAME="Basma+ API"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:8080", "http://localhost:5173", "http://localhost:3000"]
DEBUG=True
ENVIRONMENT="development"

# JWT — generate a strong key for production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-secret-key-change-in-production

# PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=basma_db

# Google OAuth (optional — leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:8080

# AI Coach (optional — leave blank for fallback mode)
GEMINI_API_KEY=

# Mail (optional — leave as dummy for mock/log mode)
MAIL_USERNAME=dummy
MAIL_PASSWORD=dummy
MAIL_FROM=noreply@basmaplus.com
MAIL_PORT=587
MAIL_SERVER=smtp.dummy.com
