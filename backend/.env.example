PROJECT_NAME="Basma+ API"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:8080", "http://localhost:5173", "http://localhost:3000"]
DEBUG=True
ENVIRONMENT="development"

# JWT
SECRET_KEY=change_me_in_production

# PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=basma_db

# Google OAuth — obtain from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:8080

# Mail (optional — leave as dummy for mock/log mode)
MAIL_USERNAME=dummy
MAIL_PASSWORD=dummy
MAIL_FROM=noreply@basmaplus.com
MAIL_PORT=587
MAIL_SERVER=smtp.dummy.com
